bubbleSort <- function (arr) {
n = length(arr)
for (i : 1:(n-1)) {
bubbleSort <- function (arr) {
n = length(arr)
for (i : 1:(n-1)) {
bubbleSort <- function (arr) {
n = length(arr)
for (i in 1:(n-1)) {
for(j in 1:(n-i)) {
if(arr[j] > arr[j+1]) {
temp <- arr[j]
arr[j] = arr[j+1]
arr[j+1] = temp
}
}
}
return arr
bubbleSort <- function (arr) {
n = length(arr)
for (i in 1:(n-1)) {
for(j in 1:(n-i)) {
if(arr[j] > arr[j+1]) {
temp <- arr[j]
arr[j] = arr[j+1]
arr[j+1] = temp
}
}
}
return (arr)
}
arr = s(6,9,7,3,1,8)
bubbleSort <- function (arr) {
n = length(arr)
for (i in 1:(n-1)) {
for(j in 1:(n-i)) {
if(arr[j] > arr[j+1]) {
temp <- arr[j]
arr[j] = arr[j+1]
arr[j+1] = temp
}
}
}
return (arr)
}
arr = c(6,9,7,3,1,8)
print(bubbleSort(arr))
