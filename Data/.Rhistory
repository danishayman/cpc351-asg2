}else{
print ("You failed!")
}
# Selection 03 =================
month <- 5
if(month == 1){
print("January")
}else if(month == 2){
print("February")
}else if(month == 3){
print("March")
}else if(month == 4){
print("April")
}else if(month == 5){
print("May")
}else if(month == 6){
print("June")
}else if(month == 7){
print("July")
}else if(month == 8){
print("August")
}else if(month == 9){
print("September")
}else if(month == 10){
print("October")
}else if(month == 11){
print("November")
}else if(month == 12){
print("December")
}else{
print("Invalid input!")
}
# Loops 01 =================
num <- 1
repeat {
print(num)
num <- num + 2
if(num >= 20) {
break
}
}
# Loops 02 =================
num <- 1
while(num <= 20) {
print(num)
num <- num + 2
}
# Loops 03 =================
for(i in 1:20){
if(i %% 2 == 1){
print(i)
}
}
# Functions 01 =================
# Create a sequence of numbers from 6 to 20
seq(6,20)
# Find mean of numbers from 72 to 82
mean(72:82)
# Find sum of numbers from 41 to 68
sum(41:68)
# Convert a vector string to lowercase
tolower("Principles of Data Analytics")
# Convert a vector string to uppercase
toupper("Principles of Data Analytics")
# Functions 02 =================
# Create a function that takes in
# the length and width of a rectangle
# and returns the perimeter of the rectangle
calcRectPerimeter <- function(length, width) {
perimeter <- 2 * (length + width)
return (perimeter)
}
# Call the calcRectPerimeter supplying 6 & 7 as arguments
p <- calcRectPerimeter(6, 7)
print(p)
# Call the calcRectPerimeter supplying 4 & 5 as arguments
p <- calcRectPerimeter(length = 4, width = 5)
print(p)
# Functions 03 =================
# Create a user-defined function which takes in
# a default parameter value
functionX <- function(name = "Ali", state = "Kedah") {
cat (name, "is from", state, "\n")
}
functionX("Muthu", "Kelantan")
functionX() #Take from default
functionX("Wong", "Johor")
# Strings 01 =================
# A string which is stated within a pair of single quote
aString <- 'CPC351/CPM351 Principles of Data Analytics'
print(aString)
# A string which is stated within a pair of double quotes
aString <- "CPC351/CPM351 Principles of Data Analytics"
print(aString)
# Strings 02 =================
aString <- "CPC351/CPM351 Principles of Data Analytics"
# Find the number of characters of a string
nchar(aString)
# Convert a vector string to lowercase
tolower("CPC351/CPM351 Principles of Data Analytics")
# Convert a vector string to uppercase
toupper("CPC351/CPM351 Principles of Data Analytics")
# Extract characters from 5th to 15th position
substring(aString, 5, 15)
# Strings 03 =================
a <- "CPC351/CPM351"
b <- "Principles"
c <- "of"
d <- "Data Analytics     "
print(paste(a, b, c, d))
# Parameter sep represents the separator between the arguments. It is optional.
print(paste(a, b, c, d, sep = "#"))
# Parameter collapse is used to eliminate the space in between two strings,
# but not the space within two words of one string.
print(paste(a, b, c, d, sep = "", collapse = ""))
# Strings 04 =================
aString <- "1,Ali,R Programming,A,90.23"
# Split a string into multiple element,
# and assign the first element to a new variable x,
# using double-square-brackets [[]] subsetting
x <- strsplit(aString, ",")[[1]]
# Print the second element
x[2]
# Use a for loop to print all the elements in x
for(i in x){
print(i)
}
# Vectors 01 =================
# Create a vector "red" "yellow" "blue"
u <- c("red", "yellow", "blue")
# Returns "red" "yellow" "blue"
u
# Returns "red" (1st element in u)
u[1]
# Returns "blue" (3rd element in u)
u[3]
# Vectors 02 =================
# Create a vector 1 2 3 4 5
v <- 1:5
# Returns 1 2 3 4 5
v
# Returns 15
sum(v)
# Create a vector 2 4 6 8 10
w <- v * 2
# Returns 2 4 6 8 10
w
# Returns 6 (the 3rd element of w)
w[3]
# Vectors 03 =================
# Sums two vectors element by element
z <- v + w
# Returns 3 6 9 12 15
z
# Returns FALSE FALSE TRUE TRUE TRUE
z > 8
# Returns 9 12 15
z[z > 8]
# Returns 3 9 12 15 ("|" denotes "or")
z[z > 8 | z < 5]
# Vectors 04 =================
# Create a logical vector of length 3
a <- vector(length=3)
# Returns FALSE FALSE FALSE
a
# Create a numeric vector of length 3
b <- vector(mode="numeric", 3)
# Returns "double"
typeof(b)
# Assign 3.1 to the 2nd element
b[2] <- 3.1
# Returns 0.0 3.1 0.0
b
# Returns 3
length(b)
# Create an integer vector of length 0
c <- vector(mode="integer", 0)
# Returns integer(0)
c
# Returns 0
length(c)
