# Arrays and Matrices 03 =================
library(matrixcalc)
# Build a 3x3 matrix
M <- matrix(c(1,3,3,5,0,4,3,3,3),nrow = 3,ncol = 3)
# Print matrix M
print(M)
# Multiply M by inverse(M) to obtain the identity matrix
M %*% matrix.inverse(M)
# Transpose matrix M
t(M)
# Data Frames 01 =================
# Create the data frame
std_data <- data.frame(
id = c (1:5),
name = c("Aaron", "Ben", "Catherine", "Danny", "Eve"),
marks = c(95.7, 66.4, 54.2, 88.5, 66.3),
gender = factor(c("M", "M", "F", "M", "F"))
)
# Print the data frame
print(std_data)
# Print the number of row in a data frame
length(std_data$id)
# Check whether the name column is a vector or not
is.vector(std_data$name)
# Check whether the gender column is a factor or not
is.factor(std_data$gender)
# Data Frames 02 =================
# Get the structure of the data frame.
str(std_data)
# Print the summary.
print(summary(std_data))
# Data Frames 03 =================
# Extract specific columns
result <- data.frame(std_data$name, std_data$marks)
print(result)
# Extract first two rows
result <- std_data[1:2,]
print(result)
# Extract 3rd and 5th row with 2nd and 4th column
result <- std_data[c(3,5),c(2,4)]
print(result)
# Data Frames 04 =================
# Add the "major" column
std_data$major <- factor(c("Software Engineering","Intelligent System","Security","Security","Intelligent System"))
print(std_data)
# Create the second data frame
std_new_data <- 	data.frame(
id = c (6:8),
name = c("Fanny","Gerald","Heidi"),
marks = c(85.4,75.4,62.8),
gender = factor(c("F","M","F")),
major = c("Software Engineering","Security","Software Engineering")
)
# Bind the two data frames
std_final_data <- rbind(std_data, std_new_data)
print(std_final_data)
