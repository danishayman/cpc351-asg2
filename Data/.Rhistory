# Create data points
x <- c(1, 8, 3, 2, 5, 6)
y <- c(12, 9, 10, 4, 2, 6)
# Create the scatter plot
plot(x, y, main="Scatter Plot of Ordered Pairs", xlab="X-axis", ylab="Y-axis", pch=19)
